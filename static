/* ========================================
   GLOBAL
======================================== */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #f5f7fb;
  color: #1f2937;
  line-height: 1.6;
}

.container {
  width: min(1180px, 92%);
  margin: 0 auto;
}

/* ========================================
   HEADER
======================================== */

.header {
  background: #111827;
  padding: 26px 0;
  border-bottom: 1px solid #273244;
}

.brand h1 {
  color: #ffffff;
  font-size: 28px;
  font-weight: 700;
}

.brand p {
  color: #9ca3af;
  margin-top: 5px;
  font-size: 14px;
}

/* ========================================
   HERO
======================================== */

.hero {
  padding: 45px 0 30px;
}

.hero h2 {
  font-size: 34px;
  color: #111827;
  margin-bottom: 10px;
}

.hero p {
  max-width: 760px;
  color: #6b7280;
  font-size: 16px;
}

/* ========================================
   FORM
======================================== */

.prediction-form {
  display: flex;
  flex-direction: column;
  gap: 22px;
}

/* ========================================
   CARDS
======================================== */

.card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  padding: 28px;
  box-shadow: 0 6px 20px rgba(17, 24, 39, 0.05);
}

.card h3 {
  font-size: 20px;
  margin-bottom: 22px;
  color: #111827;
}

/* ========================================
   INPUT GRID
======================================== */

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.input-group {
  display: flex;
  flex-direction: column;
}

.input-group label {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 7px;
  color: #374151;
}

.input-group input {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-size: 15px;
  outline: none;
  background: #ffffff;
  transition: 0.2s;
}

.input-group input:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

/* ========================================
   BUTTON GROUP
======================================== */

.button-group {
  display: flex;
  gap: 14px;
  width: 100%;
}

.predict-btn {
  flex: 1;
  padding: 16px;
  border: none;
  border-radius: 10px;
  background: #2563eb;
  color: #ffffff;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s;
}

.predict-btn:hover {
  background: #1d4ed8;
}

.predict-btn:active {
  transform: translateY(1px);
}

.reset-btn {
  width: 180px;
  padding: 16px;
  border: 1px solid #d1d5db;
  border-radius: 10px;
  background: #ffffff;
  color: #374151;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s;
}

.reset-btn:hover {
  background: #f3f4f6;
}

.reset-btn:active {
  transform: translateY(1px);
}

/* ========================================
   RESULT SECTION
======================================== */

.result-section {
  margin-top: 45px;
  margin-bottom: 50px;
}

.result-header {
  margin-bottom: 20px;
}

.result-header h2 {
  font-size: 28px;
  color: #111827;
}

.result-header p {
  color: #6b7280;
  margin-top: 5px;
}

/* ========================================
   RESULT CARDS
======================================== */

.result-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.result-card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  padding: 26px;
  box-shadow: 0 6px 20px rgba(17, 24, 39, 0.05);
}

.result-card span {
  display: block;
  color: #6b7280;
  font-size: 14px;
  margin-bottom: 12px;
}

.result-card strong {
  display: block;
  color: #111827;
  font-size: 22px;
}

/* ========================================
   FOOTER
======================================== */

.footer {
  background: #111827;
  color: #9ca3af;
  text-align: center;
  padding: 25px 15px;
  margin-top: 30px;
}

.footer p {
  font-size: 13px;
  margin: 3px 0;
}

/* ========================================
   RESPONSIVE
======================================== */

@media (max-width: 800px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .result-grid {
    grid-template-columns: 1fr;
  }

  .button-group {
    flex-direction: column;
  }

  .reset-btn {
    width: 100%;
  }

  .hero h2 {
    font-size: 28px;
  }

  .card {
    padding: 20px;
  }
}

@media (max-width: 500px) {
  .brand h1 {
    font-size: 22px;
  }

  .hero {
    padding-top: 30px;
  }

  .hero h2 {
    font-size: 24px;
  }
}
